<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Lab_6 SignalR</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-light shadow-sm mb-4"
             style="background: linear-gradient(135deg, #e0f2fe 0%, #dbeafe 50%, #e0e7ff 100%); border-bottom: 2px solid #93c5fd;">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary fs-4 ms-2" href="/">
                    ⚡ Lab_6 | SignalR Real-Time
                </a>
            </div>
        </nav>
    </header>
    <div class="container flex-grow-1 pb-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <footer class="border-top text-muted py-3 bg-white shadow-sm mt-auto text-center">
        <div class="container">
            &copy; 2026 - Lab_6 (SignalR Real-Time Web App) - Чернівецький національний університет
        </div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>