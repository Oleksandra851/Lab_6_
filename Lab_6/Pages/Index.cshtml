@page
@model Lab_6.Pages.IndexModel
@{
    ViewData["Title"] = "Реєстр викладачів (SignalR)";
}

<div class="d-flex justify-content-between align-items-center my-4">
    <h2 class="fw-bold text-secondary mb-0">Реєстр викладачів університету (SignalR Real-Time)</h2>
    <button class="btn btn-primary shadow-sm fw-semibold" onclick="openCreateModal()">+ Додати нового викладача</button>
</div>

<!-- Таблиця викладачів -->
<div class="table-responsive shadow-sm rounded-3 mb-5">
    <table class="table table-hover align-middle mb-0 bg-white" id="teachersTable">
        <thead>
            <tr>
                <th style="background-color: #dbeafe; color: #1e3a8a; padding: 14px;">ПІБ Викладача</th>
                <th style="background-color: #dbeafe; color: #1e3a8a; padding: 14px;">Телефон</th>
                <th style="background-color: #dbeafe; color: #1e3a8a; padding: 14px;">Місце роботи</th>
                <th style="background-color: #dbeafe; color: #1e3a8a; padding: 14px;">Посада</th>
                <th style="background-color: #dbeafe; color: #1e3a8a; padding: 14px;">Предмети (Години)</th>
                <th style="background-color: #dbeafe; color: #1e3a8a; padding: 14px;" class="text-center">Дії</th>
            </tr>
        </thead>
        <tbody id="teachersList">
            <!-- Заповнюється через SignalR -->
        </tbody>
    </table>
</div>

<!-- Модальне вікно для створення / редагування -->
<div class="modal fade" id="teacherModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="modalTitle">Викладач</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="teacherForm">
                    <input type="hidden" id="teacherId" value="0" />
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Прізвище</label>
                            <input type="text" id="lastName" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">Ім'я</label>
                            <input type="text" id="firstName" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-semibold">По батькові</label>
                            <input type="text" id="middleName" class="form-control" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Телефон</label>
                            <input type="text" id="phone" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">Місце роботи</label>
                            <input type="text" id="workplace" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Посада</label>
                        <select id="positionId" class="form-select" required>
                            <option value="">-- Оберіть посаду --</option>
                            @foreach (var pos in Model.Positions)
                            {
                                <option value="@pos.PositionID">@pos.PositionName</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Домашня адреса</label>
                        <input type="text" id="homeAddress" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Характеристика</label>
                        <textarea id="characteristic" class="form-control" rows="2"></textarea>
                    </div>

                    <hr class="my-4" />
                    <h5 class="fw-bold text-primary mb-3">Призначення дисциплін (множинний вибір)</h5>
                    <div class="table-responsive mb-3">
                        <table class="table table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 60px;" class="text-center">Обрати</th>
                                    <th>Предмет</th>
                                    <th style="width: 180px;">Прочитані години</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sub in Model.Subjects)
                                {
                                    <tr>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input subject-checkbox" data-subject-id="@sub.SubjectID" />
                                        </td>
                                        <td>@sub.SubjectName</td>
                                        <td>
                                            <input type="number" class="form-control subject-hours" data-subject-id="@sub.SubjectID" min="0" value="0" />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                <button type="button" class="btn btn-primary fw-semibold" onclick="saveTeacher()">Зберегти</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальне вікно для Деталей -->
<div class="modal fade" id="detailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title fw-bold">Детальна інформація про викладача</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <dl class="row fs-6">
                    <dt class="col-sm-3">ПІБ Викладача:</dt>
                    <dd class="col-sm-9 fw-semibold" id="detFullName"></dd>

                    <dt class="col-sm-3">Телефон:</dt>
                    <dd class="col-sm-9" id="detPhone"></dd>

                    <dt class="col-sm-3">Місце роботи:</dt>
                    <dd class="col-sm-9" id="detWorkplace"></dd>

                    <dt class="col-sm-3">Посада:</dt>
                    <dd class="col-sm-9" id="detPosition"></dd>

                    <dt class="col-sm-3">Домашня адреса:</dt>
                    <dd class="col-sm-9" id="detAddress"></dd>

                    <dt class="col-sm-3">Характеристика:</dt>
                    <dd class="col-sm-9" id="detCharacteristic"></dd>

                    <dt class="col-sm-3">Предмети (Години):</dt>
                    <dd class="col-sm-9" id="detSubjects"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрити</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/teacherHub")
            .build();

        // Отримання списку викладачів
        connection.on("ReceiveTeachers", function(teachers) {
            const tbody = document.getElementById("teachersList");
            tbody.innerHTML = "";

            teachers.forEach(t => {
                let subjectsHtml = '<span class="text-muted fst-italic">Не призначено</span>';
                if (t.subjects && t.subjects.length > 0) {
                    subjectsHtml = '<ul class="list-unstyled mb-0">' +
                        t.subjects.map(s => `<li>• ${s.subjectName} <span class="text-muted">(${s.hoursRead} год)</span></li>`).join('') +
                        '</ul>';
                }

                const tr = document.createElement("tr");
                tr.innerHTML = `
                            <td class="fw-semibold">${t.lastName} ${t.firstName} ${t.middleName ?? ''}</td>
                            <td>${t.phone ?? ''}</td>
                            <td>${t.workplace ?? ''}</td>
                            <td><span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1 fs-6">${t.positionName}</span></td>
                            <td>${subjectsHtml}</td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-warning fw-semibold" onclick="openEditModal(${t.teacherID})">Редагувати</button>
                                    <button class="btn btn-info text-white fw-semibold" onclick="openDetailsModal(${t.teacherID})">Деталі</button>
                                    <button class="btn btn-danger fw-semibold" onclick="deleteTeacher(${t.teacherID})">Видалити</button>
                                </div>
                            </td>
                        `;
                tbody.appendChild(tr);
            });
        });

        // Заповнення форми редагування
        connection.on("ReceiveTeacherDetails", function(t) {
            if (window.isDetailsRequested) {
                document.getElementById("detFullName").innerText = `${t.lastName} ${t.firstName} ${t.middleName ?? ''}`;
                document.getElementById("detPhone").innerText = t.phone ?? '—';
                document.getElementById("detWorkplace").innerText = t.workplace ?? '—';
                document.getElementById("detPosition").innerText = t.positionName ?? '—';
                document.getElementById("detAddress").innerText = t.homeAddress ?? '—';
                document.getElementById("detCharacteristic").innerText = t.characteristic ?? '—';

                let subHtml = 'Нічого не призначено';
                if (t.subjects && t.subjects.length > 0) {
                    subHtml = '<ul class="list-unstyled mb-0">' +
                        t.subjects.map(s => `<li>• <strong>${s.subjectName}</strong> — ${s.hoursRead} год.</li>`).join('') +
                        '</ul>';
                }
                document.getElementById("detSubjects").innerHTML = subHtml;

                new bootstrap.Modal(document.getElementById('detailsModal')).show();
                window.isDetailsRequested = false;
                return;
            }

            document.getElementById("teacherId").value = t.teacherID;
            document.getElementById("lastName").value = t.lastName;
            document.getElementById("firstName").value = t.firstName;
            document.getElementById("middleName").value = t.middleName ?? "";
            document.getElementById("phone").value = t.phone ?? "";
            document.getElementById("workplace").value = t.workplace ?? "";
            document.getElementById("positionId").value = t.positionID;
            document.getElementById("homeAddress").value = t.homeAddress ?? "";
            document.getElementById("characteristic").value = t.characteristic ?? "";

            document.querySelectorAll(".subject-checkbox").forEach(cb => cb.checked = false);
            document.querySelectorAll(".subject-hours").forEach(inp => inp.value = 0);

            if (t.subjects) {
                t.subjects.forEach(sub => {
                    const cb = document.querySelector(`.subject-checkbox[data-subject-id='${sub.subjectID}']`);
                    const inp = document.querySelector(`.subject-hours[data-subject-id='${sub.subjectID}']`);
                    if (cb) cb.checked = true;
                    if (inp) inp.value = sub.hoursRead;
                });
            }

            document.getElementById("modalTitle").innerText = "Редагування викладача";
            new bootstrap.Modal(document.getElementById('teacherModal')).show();
        });

        // Підключення SignalR
        connection.start().then(function() {
            connection.invoke("GetTeachers");
        }).catch(err => console.error(err.toString()));

        function openCreateModal() {
            document.getElementById("teacherForm").reset();
            document.getElementById("teacherId").value = 0;
            document.querySelectorAll(".subject-checkbox").forEach(cb => cb.checked = false);
            document.querySelectorAll(".subject-hours").forEach(inp => inp.value = 0);
            document.getElementById("modalTitle").innerText = "Додавання викладача";
            new bootstrap.Modal(document.getElementById('teacherModal')).show();
        }

        function openEditModal(id) {
            window.isDetailsRequested = false;
            connection.invoke("GetTeacherById", id);
        }

        function openDetailsModal(id) {
            window.isDetailsRequested = true;
            connection.invoke("GetTeacherById", id);
        }

        function saveTeacher() {
            const id = parseInt(document.getElementById("teacherId").value);
            const teacher = {
                teacherID: id,
                lastName: document.getElementById("lastName").value,
                firstName: document.getElementById("firstName").value,
                middleName: document.getElementById("middleName").value,
                phone: document.getElementById("phone").value,
                workplace: document.getElementById("workplace").value,
                positionID: parseInt(document.getElementById("positionId").value),
                homeAddress: document.getElementById("homeAddress").value,
                characteristic: document.getElementById("characteristic").value
            };

            const selectedSubjects = [];
            document.querySelectorAll(".subject-checkbox").forEach(cb => {
                if (cb.checked) {
                    const subjectId = parseInt(cb.getAttribute("data-subject-id"));
                    const hoursInput = document.querySelector(`.subject-hours[data-subject-id='${subjectId}']`);
                    const hoursRead = hoursInput ? parseInt(hoursInput.value) || 0 : 0;
                    selectedSubjects.push({ subjectID: subjectId, hoursRead: hoursRead });
                }
            });

            if (id === 0) {
                connection.invoke("CreateTeacher", teacher, selectedSubjects);
            } else {
                connection.invoke("UpdateTeacher", teacher, selectedSubjects);
            }

            bootstrap.Modal.getInstance(document.getElementById('teacherModal')).hide();
        }

        function deleteTeacher(id) {
            if (confirm("Ви дійсно бажаєте видалити цього викладача?")) {
                connection.invoke("DeleteTeacher", id);
            }
        }
    </script>
}